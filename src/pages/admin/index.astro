
---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Admin Login | Sandeep Karne"
    description="Secure portfolio administration."
>
    <main class="flex min-h-screen items-center justify-center px-5 py-24">
        <div class="w-full max-w-md rounded-3xl border border-white/10 bg-[#10121e] p-8 shadow-2xl shadow-black/30 sm:p-10">
            <div class="mb-8 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 text-2xl font-bold text-white shadow-lg shadow-violet-500/20">
                    SK
                </div>

                <h1 class="mt-6 font-heading text-3xl font-bold text-white">
                    Admin Portal
                </h1>

                <p class="mt-3 text-sm leading-6 text-gray-400">
                    Sign in to manage your portfolio and contact messages.
                </p>
            </div>

            <a
                href="/cdn-cgi/access/login/sandeep-portfolio.sandeepkarne126.workers.dev"
                class="flex w-full items-center justify-center gap-3 rounded-xl bg-gradient-to-r from-violet-500 to-indigo-600 px-5 py-4 text-sm font-semibold text-white shadow-lg shadow-violet-500/20 transition-all hover:-translate-y-0.5 hover:shadow-violet-500/40"
            >
                Continue with Google
            </a>

            <p class="mt-6 text-center text-xs text-gray-500">
                Authorized access only.
            </p>

            <a
                href="/"
                class="mt-6 block text-center text-sm text-violet-400 transition-colors hover:text-violet-300"
            >
                ← Back to portfolio
            </a>
        </div>
    </main>
</Layout>
